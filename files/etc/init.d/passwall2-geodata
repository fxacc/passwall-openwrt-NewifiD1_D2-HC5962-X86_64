#!/bin/sh /etc/rc.common

START=98
STOP=14
USE_PROCD=1

ASSET_DIR="/tmp/passwall2-geodata"
BOOTSTRAP_DIR="/usr/share/passwall2-bootstrap"

prepare_assets() {
	for name in geoip.dat geosite.dat; do
		[ -s "$BOOTSTRAP_DIR/$name" ] || {
			logger -t passwall2-geodata -- "Missing bootstrap $name; leaving PassWall2 configuration unchanged."
			return 1
		}
	done

	target_dir="$ASSET_DIR"
	mkdir -p "$ASSET_DIR" || target_dir="$BOOTSTRAP_DIR"

	if [ "$target_dir" = "$ASSET_DIR" ]; then
		for name in geoip.dat geosite.dat; do
			[ -s "$ASSET_DIR/$name" ] && continue
			if ! cp "$BOOTSTRAP_DIR/$name" "$ASSET_DIR/$name.new" || \
				! mv -f "$ASSET_DIR/$name.new" "$ASSET_DIR/$name"; then
				rm -f "$ASSET_DIR"/*.new "$ASSET_DIR"/geoip.dat "$ASSET_DIR"/geosite.dat
				target_dir="$BOOTSTRAP_DIR"
				logger -t passwall2-geodata -- "Unable to prepare RAM geodata; PassWall2 will use the read-only bootstrap files."
				break
			fi
		done
	fi

	if uci -q get passwall2.@global_rules[0] >/dev/null; then
		configured_dir="$(uci -q get passwall2.@global_rules[0].v2ray_location_asset)"
		if [ "$configured_dir" != "$target_dir/" ]; then
			uci -q set passwall2.@global_rules[0].v2ray_location_asset="$target_dir/"
			uci -q commit passwall2
		fi
	fi

	[ "$target_dir" = "$ASSET_DIR" ]
}

start_service() {
	prepare_assets || return 1

	procd_open_instance
	procd_set_param command /usr/share/passwall2/volatile-geodata.sh
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
